# Include dynamically generated versions list from latest release
$include https://github.com/choco-technologies/dmcrypto/releases/download/vlatest/versions.dmm

# Module entries with version placeholder - expanded by $version-available.
#
# dmcrypto is the interface (no algorithms): built per architecture. The port
# is one module, dmcrypto_port, in two packagings - exactly one is installed:
#   dmcrypto_port     the hardware port of a CPU family (<cpu_family>); what the
#                     family's peripherals lack it has in software
#   dmcrypto_port_sw  the software port, for any architecture (<arch_name>)
# Which a chip gets (an STM32F746 has no CRYP/HASH, an STM32F756 has) is
# decided where the chip is known - the board's flash.dmd names the one it takes.
dmcrypto         https://github.com/choco-technologies/dmcrypto/releases/download/v<version>/dmcrypto-v<version>-<arch_name>.zip
test_dmcrypto    https://github.com/choco-technologies/dmcrypto/releases/download/v<version>/test_dmcrypto-v<version>-<arch_name>.zip
dmcrypto_port    https://github.com/choco-technologies/dmcrypto/releases/download/v<version>/dmcrypto_port-v<version>-<cpu_family>.zip
dmcrypto_port_sw https://github.com/choco-technologies/dmcrypto/releases/download/v<version>/dmcrypto_port_sw-v<version>-<arch_name>.zip
